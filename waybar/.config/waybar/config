{
  "layer": "top",
  "position": "top",
  "margin-bottom": -10,
  "spacing" : 0,

  "modules-left": [
    "hyprland/workspaces",
    "temperature",
    "cpu",
    "memory",
  ],

  "modules-center": [
    "custom/music",
    "clock",
  ],

  "modules-right": [
    "bluetooth",
    "network",
    "pulseaudio", 
    "custom/nightlight",
    "battery",
  ],

  "hyprland/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },

  "bluetooth": {
    "format": "󰂲",
    "format-on": "{icon}",
    "format-off": "{icon}", 
    "format-connected":"{icon}",
    "format-icons":{
        "on":"󰂯",
        "off": "󰂲",
        "connected": "󰂱",
        },
    "on-click": "blueman-manager",
    "tooltip-format-connected":"{device_enumerate}"
  },

  "custom/music": {
    "format": "  {}",
    "escape": true,
    "interval": 1,
    "tooltip": false,
    "exec": "playerctl metadata --format='{{ artist }} - {{ title }}'",
    "on-click": "playerctl play-pause",
    "on-double-click": "playerctl next",
    "on-click-right": "playerctl previous",
    "max-length": 50
  },

  "clock": {
    "timezone": "America/New York",
    "tooltip": false,
    "format": "{:%H:%M  -  %a/%d/%b}",
    "interval": 1
  },

  "network": {
    "format-wifi": "󰤢",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "kitty -e nmtui"

 },

  "cpu": {
    "interval": 3,
    // "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format": " {usage:>2}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "on-click": "ghostty -e htop"
  },

  "memory": {
    "interval": 3,
    "format": "  {used:0.1f}G",
    "tooltip-format": "Memory"
  },

  "temperature": {
    "warning-threshold": 60,
    "critical-threshold": 80,
    "format": " {temperatureC}° ",
    "tooltip": false,
    "interval": 3
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

  "custom/uptime": {
    "format-icon": [""], 
    "format": "{}",
    "tooltip": false,
    "interval": 1600,
    "exec": "sleep 5 & $HOME/.config/waybar/scripts/uptime.sh"
  },
  
  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": ["","󰃜", "󰃛", "󰃞","󰃝","󰃟","󰃠"],
    "tooltip": false,
    "on-click": "brightness-controller"
  },

  "custom/nightlight": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/nightlight.sh",
    "interval": 1,
    "tooltip": false,
    "on-click": "$HOME/.config/waybar/scripts/nightlight-toggle.sh"
  },
  
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "pavucontrol"
  },

  "battery": {
        "interval":2,
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-full": "{icon}  {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
  },
  
  "custom/lock": {
  "tooltip": false,
  "on-click": "sh -c '(sleep 0s; hyprlock)' & disown",
  "format" : ""
  },

  "custom/pomodoro": {
	"format": "{}",
	"return-type": "json",
	"exec": "waybar-module-pomodoro --no-work-icons & sleep 0.2 && waybar-module-pomodoro set-work 45",
	"on-click": "waybar-module-pomodoro toggle",
	"on-click-right": "waybar-module-pomodoro reset",
  },

}

